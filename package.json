{
  "name": "mailschema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "npm run spec:check && npm run draft:check && astro check",
    "verify": "npm run check && npm run build && npm test",
    "build": "astro build",
    "deploy": "npm run verify && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "packages:prepare": "node scripts/prepare-packages.mjs",
    "packages:promote": "node scripts/promote-package.mjs",
    "packages:test": "node --test tests/packages-check.mjs",
    "packages:upstream": "node scripts/package-upstream.mjs",
    "draft": "node scripts/draft.mjs",
    "draft:check": "node scripts/draft.mjs --check",
    "spec:generate": "node scripts/map-0.3.mjs && npm run draft",
    "spec:check": "node scripts/map-0.3.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.5",
    "sourcey": "3.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@types/jsonld": "1.5.15",
    "@types/node": "24.13.6",
    "jsonld": "9.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "wrangler": "^4.137.0"
  }
}
